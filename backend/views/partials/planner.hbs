<!DOCTYPE html>
<html lang="nl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Semester Planner - overzicht van je weken">
    <title>Overzicht - Semester Planner</title>
    <link rel="stylesheet" href="../static/style.css">
</head>

<body>

    <header class="topbar">

        <a href="planner.html" class="logo">

            <span class="brand-icon small">
                SP
            </span>

            <span>
                Semester Planner
            </span>

        </a>

        <nav class="navigation">

            <a href="planner.html" class="active">
                Overzicht
            </a>

            <a href="/create">
                Nieuwe activiteit
            </a>

            <a href="index.html">
                Uitloggen
            </a>

        </nav>

    </header>

    <main class="container">

        <div class="page-heading">

            <div>

                <span class="eyebrow">
                    MIJN SEMESTER
                </span>

                <h2>
                    Semester Planner
                </h2>

                <p>
                    Plan je weken en houd je activiteiten overzichtelijk bij.
                </p>

            </div>

            <a href="/activities/create-activity" class="button button-primary">
                + activiteit
            </a>

        </div>

        <div class="stats">

            <div class="stat-card">

                <div class="stat-icon">
                    ▣
                </div>

                <div>
                    <strong>
                        2
                    </strong>

                    <span>
                        Weken
                    </span>
                </div>

            </div>

            <div class="stat-card">

                <div class="stat-icon">
                    ✓
                </div>

                <div>
                    <strong>
                        4
                    </strong>

                    <span>
                        Activiteiten
                    </span>
                </div>

            </div>

            <div class="stat-card">

                <div class="stat-icon">
                    ◷
                </div>

                <div>
                    <strong>
                        Semester 1
                    </strong>

                    <span>
                        Huidige periode
                    </span>
                </div>

            </div>

        </div>

        <div class="section-heading">

            <div>

                <h3>
                    Mijn weken
                </h3>

                <p>
                    Klik op een week om de activiteiten te bekijken.
                </p>

            </div>

        </div>

        <div class="week-grid">

            {{#each fetchedWeeks}}

                <a href="/activities/overview/week/{{this}}" class="week-card">
                    <div class="week-top">

                        <span class="week-number">
                            {{this}}
                        </span>

                        <span class="status status-blue">
                            Actief
                        </span>

                    </div>

                    <h3>
                        Week {{this}}
                    </h3>

                    <p>
                        Start van het semester
                    </p>

                    <div class="week-footer">

                        <span>
                            ? activiteiten
                        </span>

                        <span class="arrow">
                            →
                        </span>

                    </div>
                </a>
            {{/each}}
        </div>

    </main>

    <script src="script.js"></script>

</body>

</html>