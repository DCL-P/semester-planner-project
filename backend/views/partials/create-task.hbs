<!DOCTYPE html>
<html lang="nl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Nieuwe activiteit aanmaken">
    <title>Nieuwe activiteit - Semester Planner</title>
    <link rel="stylesheet" href="/static/style.css">
</head>

<body>

    <header class="topbar">
        <a href="/activities/planner" class="logo">
            <span class="brand-icon small">SP</span>
            <span>Semester Planner</span>
        </a>
    </header>

    <main class="container narrow">
        <a href="/activities/planner" class="back-link">&larr; Terug naar overzicht</a>

        <div class="form-card">
            <div class="form-header">
                <div class="form-icon">+</div>

                <div>
                    <span class="eyebrow">NIEUWE PLANNING</span>
                    <h2>Activiteit aanmaken</h2>
                    <p>Voeg een nieuwe activiteit toe aan je semester.</p>
                </div>
            </div>

            <form class="form" method="POST" action="/activities/create">
                <div class="input-group">
                    <label for="week-number">Week</label>
                    <input id="week-number" type="number" name="week" min="1" required>
                </div>

                <div class="input-group">
                    <label for="activity-title">Titel</label>
                    <input id="activity-title" type="text" name="title" required>
                </div>

                <div class="input-group">
                    <label for="activity-description">Beschrijving</label>
                    <textarea id="activity-description" name="description" rows="6" required></textarea>
                </div>
                <div class="input-row">
                    <div class="input-group">
                        <label for="activity-start">Startdatum</label>
                        <input id="activity-start" type="date" name="start" required>
                    </div>

                    <div class="input-group">
                        <label for="activity-end">Einddatum</label>
                        <input id="activity-end" type="date" name="end" required>
                    </div>
                </div>

                <div class="form-actions">
                    <a href="/" class="button button-secondary">Annuleren</a>
                    <button type="submit" class="button button-primary">Aanmaken</button>
                </div>
            </form>
        </div>
    </main>

</body>

</html>