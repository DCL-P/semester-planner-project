<!DOCTYPE html>
<html lang="nl">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="description" content="Semester Planner - plan je weken en activiteiten">
    <title>Semester Planner</title>
    <link rel="stylesheet" href="static/style.css">
</head>

<body>

    <section id="login" class="screen login-screen">

        <div class="login-card">

            <div class="brand">

                <div class="brand-icon">
                    SP
                </div>

                <div>
                    <span class="eyebrow">
                        STUDENT TOOL
                    </span>

                    <h1>
                        Semester Planner
                    </h1>
                </div>

            </div>

            <p class="login-description">
                Log in om je semester, weken en activiteiten te beheren.
            </p>

            <form class="form" method="POST" action="/auth/login">

                <div class="input-group">
                    <label for="username">
                        username
                    </label>

                    <input
                        id="username"
                        name="username"
                        type="username"
                        placeholder="bob"
                    >
                </div>

                <div class="input-group">
                    <label for="password">
                        Wachtwoord
                    </label>

                    <input
                        id="password"
                        name="password"
                        type="password"
                        placeholder="••••••••"
                    >
                </div>

                <button class="button button-primary button-full" type="submit">
                    login
                </button>

            </form>


            <form class="login-footer" method="GET" action="/auth/signup">
                <button class="" type="submit">ik heb nog geen account!</button>
            </form>

        </div>

    </section>

    <script src="script.js"></script>

</body>

</html>